{
  "geode": "4.10.0",
  "gd": {
    "win": "2.2074",
    "android": "2.2074",
    "ios": "2.2074"
  },
  "id": "lntb017.xfc",
  "name": "X FRAME COUNTER",
  "version": "v2.9.6",
  "developers": ["LNTB017"],
  "description": "Exact click windows (in frames) for .gdr macros: counter rows 0-1 ... 15-20, coloured circles on every click, sounds, auto-open level.",
  "tags": [
    "utility"
  ],
  "resources": {
    "files": [
      "resources/*.wav",
      "resources/*.otf"
    ],
    "sprites": [
      "resources/*.png"
    ]
  },
  "settings": {
    "show-hud": {
      "type": "bool",
      "default": true,
      "name": "Show HUD"
    },
    "show-tiers": {
      "type": "bool",
      "default": true,
      "name": "Counter rows (12 windows)"
    },
    "show-ms": {
      "type": "bool",
      "default": true,
      "name": "Window in ms"
    },
    "hud-scale": {
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "name": "HUD scale"
    },
    "show-rings": {
      "type": "bool",
      "default": true,
      "name": "Circle on every click"
    },
    "ring-label": {
      "type": "bool",
      "default": true,
      "name": "Exact frame above circle"
    },
    "ring-scale": {
      "type": "float",
      "default": 1.0,
      "min": 0.4,
      "max": 2.5,
      "name": "Circle size"
    },
    "ring-time": {
      "type": "float",
      "default": 1.5,
      "min": 0.0,
      "max": 8.0,
      "name": "Circle lifetime (s, 0 = stay)"
    },
    "tps-enabled": {
      "type": "bool",
      "default": false,
      "name": "Custom TPS"
    },
    "tps": {
      "type": "int",
      "default": 240,
      "min": 30,
      "max": 4800,
      "name": "TPS"
    },
    "fps-enabled": {
      "type": "bool",
      "default": false,
      "name": "Custom FPS"
    },
    "fps": {
      "type": "int",
      "default": 60,
      "min": 30,
      "max": 1000,
      "name": "FPS"
    },
    "link-xdbot": {
      "type": "bool",
      "default": true,
      "name": "Sync with xdBot playback"
    },
    "max-shift": {
      "type": "int",
      "default": 30,
      "min": 5,
      "max": 30,
      "name": "Max window searched (frames)"
    },
    "horizon": {
      "type": "int",
      "default": 600,
      "min": 60,
      "max": 6000,
      "name": "Survive-check length (frames)"
    },
    "show-frame": {
      "type": "bool",
      "default": true,
      "name": "Frame counter (top-left)"
    },
    "keep-last-window": {
      "type": "bool",
      "default": true,
      "name": "Keep last click window"
    },
    "tier-sounds": {
      "type": "bool",
      "default": true,
      "name": "Sound on every click window"
    },
    "sound-volume": {
      "type": "float",
      "default": 0.6,
      "min": 0.0,
      "max": 1.0,
      "name": "Sound volume"
    },
    "tier-0": {
      "type": "color",
      "default": "#ff4650",
      "name": "Colour 0-1 f"
    },
    "tier-1": {
      "type": "color",
      "default": "#ff7373",
      "name": "Colour 1-2 f"
    },
    "tier-2": {
      "type": "color",
      "default": "#ffa050",
      "name": "Colour 2-3 f"
    },
    "tier-3": {
      "type": "color",
      "default": "#ffd75a",
      "name": "Colour 3-4 f"
    },
    "tier-4": {
      "type": "color",
      "default": "#aaeb64",
      "name": "Colour 4-5 f"
    },
    "tier-5": {
      "type": "color",
      "default": "#5ae682",
      "name": "Colour 5-6 f"
    },
    "tier-6": {
      "type": "color",
      "default": "#50e1e1",
      "name": "Colour 6-7 f"
    },
    "tier-7": {
      "type": "color",
      "default": "#50a0ff",
      "name": "Colour 7-8 f"
    },
    "tier-8": {
      "type": "color",
      "default": "#6e7dff",
      "name": "Colour 8-9 f"
    },
    "tier-9": {
      "type": "color",
      "default": "#a06eff",
      "name": "Colour 9-10 f"
    },
    "tier-10": {
      "type": "color",
      "default": "#c878ff",
      "name": "Colour 10-15 f"
    },
    "tier-11": {
      "type": "color",
      "default": "#ff82e6",
      "name": "Colour 15-20 f"
    },
    "show-release-rings": {
      "type": "bool",
      "default": true,
      "name": "Circle on every release"
    }
  }
}